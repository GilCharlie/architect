// === MODELOS AVANZADOS ===
class Transaccion {
  final String id;
  final double monto;
  final String tipo; // venta, gasto, inversion
  final String categoria;
  final DateTime fecha;
  final String? producto;
  final bool optimizada;
  final String? notas;

  Transaccion({
    String? id,
    required this.monto,
    required this.tipo,
    required this.categoria,
    required this.fecha,
    this.producto,
    this.optimizada = false,
    this.notas,
  }) : id =
           id ??
           '${DateTime.now().millisecondsSinceEpoch}-${Random().nextInt(9999)}';

  Map<String, dynamic> toJson() => {
    'id': id,
    'monto': monto,
    'tipo': tipo,
    'categoria': categoria,
    'fecha': fecha.toIso8601String(),
    'producto': producto,
    'optimizada': optimizada,
    'notas': notas,
  };

  factory Transaccion.fromJson(Map<String, dynamic> json) => Transaccion(
    id: json['id'],
    monto: (json['monto'] as num).toDouble(),
    tipo: json['tipo'],
    categoria: json['categoria'],
    fecha: DateTime.parse(json['fecha']),
    producto: json['producto'],
    optimizada: json['optimizada'] ?? false,
    notas: json['notas'],
  );
}

class DecisionAutonoma {
  final String id;
  final String agente; // financiero, ventas, estrategico, sistema
  final String accion;
  final String razon;
  final DateTime timestamp;
  final double impactoEsperado;
  bool ejecutada;
  final String? resultado;

  DecisionAutonoma({
    String? id,
    required this.agente,
    required this.accion,
    required this.razon,
    required this.impactoEsperado,
    this.ejecutada = false,
    this.resultado,
  }) : id = id ?? 'dec-${DateTime.now().millisecondsSinceEpoch}',
       timestamp = DateTime.now();

  Map<String, dynamic> toJson() => {
    'id': id,
    'agente': agente,
    'accion': accion,
    'razon': razon,
    'timestamp': timestamp.toIso8601String(),
    'impactoEsperado': impactoEsperado,
    'ejecutada': ejecutada,
    'resultado': resultado,
  };
}

class Producto {
  final String id;
  String nombre;
  double precio;
  double margen;
  int ventasUltimos30Dias;
  double ratingSatisfaccion;
  double costoProduccion;
  int stock;

  Producto({
    String? id,
    required this.nombre,
    required this.precio,
    required this.margen,
    required this.ventasUltimos30Dias,
    required this.ratingSatisfaccion,
    required this.costoProduccion,
    required this.stock,
  }) : id = id ?? 'prod-${Random().nextInt(99999)}';

  double get rentabilidad =>
      ((precio - costoProduccion) / costoProduccion) * 100;
  bool get bajoStock => stock < 10;
  bool get altoRendimiento => ventasUltimos30Dias > 50 && margen > 0.25;
}

// === SERVICIO DE PREDICCIÓN (Simulado) ===
class PredictorIA {
  static Future<double> predecirVentasProximas(
    List<Transaccion> historial,
  ) async {
    // Simulación de predicción con IA
    await Future.delayed(const Duration(milliseconds: 200));

    if (historial.isEmpty) return 0;

    final ventasRecientes = historial
        .where((t) => t.tipo == 'venta')
        .where(
          (t) => t.fecha.isAfter(
            DateTime.now().subtract(const Duration(days: 30)),
          ),
        )
        .toList();

    if (ventasRecientes.isEmpty) return 0;

    final total = ventasRecientes.map((v) => v.monto).reduce((a, b) => a + b);
    final promedioDiario = total / 30;

    // Factor de crecimiento (simulado)
    final factorCrecimiento = 1 + (Random().nextDouble() * 0.3 - 0.1);

    return promedioDiario * 30 * factorCrecimiento;
  }

  static Future<String> obtenerRecomendacionEstrategica(
    double balance,
    double crecimiento,
    double eficiencia,
  ) async {
    await Future.delayed(const Duration(milliseconds: 150));

    if (balance < 0)
      return "⚠️ Enfoque urgente en reducción de costos y aumento de liquidez";
    if (crecimiento < 0)
      return "📉 Revisar estrategia comercial y considerar promociones agresivas";
    if (eficiencia < 0.5)
      return "🔧 Optimizar procesos operativos para mejorar margen";
    if (balance > 10000 && crecimiento > 0.1)
      return "🚀 Excelente posición para expansión o inversión";

    return "✅ Sistema listo. Empieza a registrar transacciones para obtener análisis personalizado";
  }
}

// === SISTEMA PRINCIPAL ===
class SistemaAutonomoPro extends StatefulWidget {
  const SistemaAutonomoPro({super.key});

  @override
  State<SistemaAutonomoPro> createState() => _SistemaAutonomoProState();
}

class _SistemaAutonomoProState extends State<SistemaAutonomoPro> {
  // === DATOS ===
  final List<Transaccion> _transacciones = [];
  final List<DecisionAutonoma> _decisiones = [];
  final List<Producto> _productos = [
    Producto(
      nombre: "Smartphone Pro",
      precio: 899,
      margen: 0.35,
      ventasUltimos30Dias: 0,
      ratingSatisfaccion: 4.7,
      costoProduccion: 580,
      stock: 0,
    ),
    Producto(
      nombre: "Laptop Ultra",
      precio: 1299,
      margen: 0.28,
      ventasUltimos30Dias: 0,
      ratingSatisfaccion: 4.5,
      costoProduccion: 935,
      stock: 0,
    ),
    Producto(
      nombre: "Tablet Basic",
      precio: 299,
      margen: 0.22,
      ventasUltimos30Dias: 0,
      ratingSatisfaccion: 4.2,
      costoProduccion: 233,
      stock: 0,
    ),
  ];

  // === MÉTRICAS DINÁMICAS ===
  double _prediccionVentas30Dias = 0;
  String _recomendacionIA = "Cargando análisis inicial...";
  bool _cargandoIA = false;

  // === GETTERS ===
  double get _ingresosTotales => _transacciones
      .where((t) => t.tipo == "venta")
      .fold(0, (sum, t) => sum + t.monto);

  double get _gastosTotales => _transacciones
      .where((t) => t.tipo == "gasto")
      .fold(0, (sum, t) => sum + t.monto);

  double get _balance => _ingresosTotales - _gastosTotales;

  double get _eficienciaOperativa {
    if (_ingresosTotales == 0) return 0.0;
    return max(0, 1 - (_gastosTotales / _ingresosTotales));
  }

  double get _tasaCrecimiento {
    final ventas = _transacciones.where((t) => t.tipo == "venta").toList();
    if (ventas.length < 2) return 0;

    final mitad = (ventas.length / 2).floor();
    final primeraMitad = ventas.sublist(0, mitad);
    final segundaMitad = ventas.sublist(mitad);

    final promPrimera = primeraMitad.isEmpty
        ? 0
        : primeraMitad.map((v) => v.monto).reduce((a, b) => a + b) /
              primeraMitad.length;
    final promSegunda = segundaMitad.isEmpty
        ? 0
        : segundaMitad.map((v) => v.monto).reduce((a, b) => a + b) /
              segundaMitad.length;

    if (promPrimera == 0) return 0;
    return ((promSegunda - promPrimera) / promPrimera);
  }

  // === CICLO DE VIDA ===
  @override
  void initState() {
    super.initState();
    // NO cargar datos iniciales - el usuario empezará desde cero
    _iniciarMonitoreoAutonomo();
    _actualizarPrediccionesIA();
  }

  void _iniciarMonitoreoAutonomo() {
    // Monitoreo continuo cada 2 minutos
    Timer.periodic(const Duration(minutes: 2), (timer) {
      if (mounted) {
        _ejecutarCicloAnalisis();
      }
    });
  }

  // === FUNCIONES PRINCIPALES ===
  Future<void> _actualizarPrediccionesIA() async {
    setState(() => _cargandoIA = true);

    try {
      _prediccionVentas30Dias = await PredictorIA.predecirVentasProximas(
        _transacciones,
      );
      _recomendacionIA = await PredictorIA.obtenerRecomendacionEstrategica(
        _balance,
        _tasaCrecimiento,
        _eficienciaOperativa,
      );
    } catch (e) {
      _recomendacionIA = "⚠️ Error en análisis IA: $e";
    }

    setState(() => _cargandoIA = false);
  }

  void _ejecutarCicloAnalisis() {
    if (_transacciones.isNotEmpty) {
      _analisisAgenteFinanciero();
      _analisisAgenteVentas();
      _analisisAgenteEstrategico();
      _verificarAlertasCriticas();
    }
    _actualizarPrediccionesIA();
  }

  void _analisisAgenteFinanciero() {
    // Detección de fugas
    if (_ingresosTotales > 0 && _gastosTotales > _ingresosTotales * 0.7) {
      _agregarDecision(
        DecisionAutonoma(
          agente: "Financiero",
          accion: "Reducir gastos operativos en 15%",
          razon:
              "Relación gastos/ingresos crítica (${(_gastosTotales / _ingresosTotales * 100).toStringAsFixed(1)}%)",
          impactoEsperado: _gastosTotales * 0.15,
        ),
      );
    }

    // Optimización presupuestaria
    if (_ingresosTotales > 0 && _eficienciaOperativa < 0.4) {
      _agregarDecision(
        DecisionAutonoma(
          agente: "Financiero",
          accion: "Optimizar cadena de suministro",
          razon:
              "Eficiencia operativa baja (${(_eficienciaOperativa * 100).toStringAsFixed(1)}%)",
          impactoEsperado: _gastosTotales * 0.1,
        ),
      );
    }

    // Control de inventario
    final productosBajoStock = _productos.where((p) => p.bajoStock);
    if (productosBajoStock.isNotEmpty) {
      _agregarDecision(
        DecisionAutonoma(
          agente: "Financiero",
          accion:
              "Reponer stock: ${productosBajoStock.map((p) => p.nombre).join(', ')}",
          razon:
              "${productosBajoStock.length} productos con stock bajo (<10 unidades)",
          impactoEsperado: productosBajoStock
              .map((p) => p.costoProduccion * 20)
              .reduce((a, b) => a + b),
        ),
      );
    }
  }

  void _analisisAgenteVentas() {
    // Solo analizar si hay transacciones
    if (_transacciones.isEmpty) return;

    // Productos débiles
    final productosDebiles = _productos.where(
      (p) => p.ventasUltimos30Dias < 20 || p.margen < 0.2,
    );
    if (productosDebiles.isNotEmpty) {
      _agregarDecision(
        DecisionAutonoma(
          agente: "Ventas",
          accion: "Activar promoción: ${productosDebiles.first.nombre} (-25%)",
          razon:
              "Producto con bajo desempeño (${productosDebiles.first.ventasUltimos30Dias} ventas/30d, margen ${(productosDebiles.first.margen * 100).toStringAsFixed(1)}%)",
          impactoEsperado: productosDebiles.first.precio * 0.75 * 10,
        ),
      );
    }

    // Ajuste de precios dinámico
    if (_tasaCrecimiento < -0.1) {
      _agregarDecision(
        DecisionAutonoma(
          agente: "Ventas",
          accion: "Ajustar estrategia de precios",
          razon:
              "Crecimiento negativo severo (${(_tasaCrecimiento * 100).toStringAsFixed(1)}%)",
          impactoEsperado: _ingresosTotales * 0.08,
        ),
      );
    }

    // Productos estrella
    final productosEstrella = _productos.where((p) => p.altoRendimiento);
    if (productosEstrella.isNotEmpty) {
      _agregarDecision(
        DecisionAutonoma(
          agente: "Ventas",
          accion: "Destacar producto: ${productosEstrella.first.nombre}",
          razon:
              "Producto de alto rendimiento (${productosEstrella.first.ventasUltimos30Dias} ventas/30d)",
          impactoEsperado: productosEstrella.first.precio * 5,
        ),
      );
    }
  }

  void _analisisAgenteEstrategico() {
    // Solo analizar si hay datos suficientes
    if (_transacciones.length < 5) return;

    // Decisiones estratégicas basadas en posición
    if (_balance > 15000 && _tasaCrecimiento > 0.15) {
      _agregarDecision(
        DecisionAutonoma(
          agente: "Estratégico",
          accion: "Inversión en expansión de mercado",
          razon: "Posición financiera sólida y crecimiento acelerado",
          impactoEsperado: _balance * 0.25,
        ),
      );
    }

    if (_balance > 5000 && _eficienciaOperativa > 0.6) {
      _agregarDecision(
        DecisionAutonoma(
          agente: "Estratégico",
          accion: "Diversificar portafolio de productos",
          razon: "Capital disponible y operaciones eficientes",
          impactoEsperado: _balance * 0.15,
        ),
      );
    }

    // Preparación para temporadas
    final mesActual = DateTime.now().month;
    if ([11, 12].contains(mesActual)) {
      // Nov-Dic
      _agregarDecision(
        DecisionAutonoma(
          agente: "Estratégico",
          accion: "Preparar inventario para temporada alta",
          razon: "Temporada de ventas próxima (fin de año)",
          impactoEsperado: _prediccionVentas30Dias * 0.3,
        ),
      );
    }
  }

  void _verificarAlertasCriticas() {
    if (_balance < -1000) {
      _mostrarAlertaUrgente(
        "🚨 CRISIS FINANCIERA",
        "Balance negativo crítico: \$${_balance.abs().toStringAsFixed(2)}\n"
            "Acción inmediata requerida",
      );
    }

    if (_productos.where((p) => p.bajoStock).length > 2) {
      _mostrarAlertaUrgente(
        "⚠️ INVENTARIO BAJO",
        "Múltiples productos con stock crítico\n"
            "Riesgo de pérdida de ventas",
      );
    }

    final productosSinVentas = _productos.where(
      (p) => p.ventasUltimos30Dias == 0,
    );
    if (productosSinVentas.isNotEmpty && _transacciones.isNotEmpty) {
      _mostrarAlertaUrgente(
        "📦 PRODUCTOS INACTIVOS",
        "${productosSinVentas.length} productos sin ventas en 30 días\n"
            "Considerar descontinuación",
      );
    }
  }

  void _mostrarAlertaUrgente(String titulo, String mensaje) {
    ScaffoldMessenger.of(context).showSnackBar(
