  void _registrarTransaccion(
    double monto,
    String tipo,
    String categoria, {
    String? producto,
    String? notas,
  }) {
    setState(() {
      _transacciones.add(
        Transaccion(
          monto: monto,
          tipo: tipo,
          categoria: categoria,
          fecha: DateTime.now(),
          producto: producto,
          notas: notas,
        ),
      );

      // Actualizar ventas del producto si es venta
      if (tipo == 'venta' && producto != null) {
        final prod = _productos.firstWhere((p) => p.nombre == producto);
        prod.ventasUltimos30Dias++;
      }
    });

    // Ejecutar análisis después de transacción
    _ejecutarCicloAnalisis();

    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text('$tipo registrada: \$${monto.toStringAsFixed(2)}'),
        backgroundColor: tipo == 'venta' ? Colors.green : Colors.red,
      ),
    );
  }

