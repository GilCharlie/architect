          label: 'ENTENDIDO',
          textColor: Colors.white,
          onPressed: () {},
        ),
      ),
    );
  }

  void _agregarDecision(DecisionAutonoma decision) {
    if (_decisiones.any((d) => d.accion == decision.accion && !d.ejecutada)) {
      return;
    }

    setState(() => _decisiones.insert(0, decision));

    // Ejecución automática progresiva
    if (decision.agente == "Financiero" || decision.agente == "Ventas") {
      Future.delayed(const Duration(seconds: 2), () => _ejecutarDecision(0));
    }
  }

  void _ejecutarDecision(int index) {
    if (index >= _decisiones.length || _decisiones[index].ejecutada) return;

    final decision = _decisiones[index];
    setState(() => _decisiones[index].ejecutada = true);

    // Simular efectos de la decisión
    _simularEfectoDecision(decision);
  }

  void _simularEfectoDecision(DecisionAutonoma decision) {
    // Simulación de efectos según tipo de decisión
    if (decision.agente == "Financiero" &&
        decision.accion.contains("Reducir gastos")) {
      _transacciones.add(
        Transaccion(
          monto: -decision.impactoEsperado * 0.8, // Simular ahorro
          tipo: "gasto",
          categoria: "optimizacion",
          fecha: DateTime.now(),
          optimizada: true,
          notas: "Ahorro por: ${decision.accion}",
        ),
      );
    }

    if (decision.agente == "Ventas" && decision.accion.contains("promoción")) {
      final productoNombre = decision.accion.split(": ")[1].split(" (")[0];
      _transacciones.add(
        Transaccion(
          monto: decision.impactoEsperado / 3,
          tipo: "venta",
          categoria: "promocion",
          fecha: DateTime.now(),
          producto: productoNombre,
          notas: "Ventas por promoción automática",
        ),
      );
    }
  }

